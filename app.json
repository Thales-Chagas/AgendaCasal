{
  "expo": {
    "name": "DuoDay",
    "slug": "duoday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duoday",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF8F6",
    "ios": {
      "bundleIdentifier": "br.com.duoday",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use o Face ID para proteger suas notas privadas."
      }
    },
    "android": {
      "package": "br.com.duoday",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#161216"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use o Face ID para proteger suas notas privadas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para proteger suas notas privadas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B8385A"
        }
      ],
      "expo-localization",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3738207b-eb58-4d13-98ad-12ae005003c6"
      }
    },
    "owner": "thaleschagas-team"
  }
}
